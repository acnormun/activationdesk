# ============================================================
# Activation Desk — environment variables (reference)
# ============================================================
# Single source of truth for env vars (backend + frontend).
#
# Railway: set these as service variables. The Postgres plugin injects
# DATABASE_URL and PORT automatically. For local dev, copy to a .env next
# to the backend (backend/app reads it from the process env or a local .env).

# ---------- Backend (FastAPI) ----------

# Railway injects this automatically when you attach a Postgres.
# The app rewrites postgres:// / postgresql:// to the psycopg3 driver.
DATABASE_URL=postgresql://user:password@host:5432/database

# Session token signing key. REQUIRED in production.
SECRET_KEY=change-me-in-production

# Comma-separated origins allowed to call the API with cookies (CORS).
# Set to your frontend URL, e.g. https://<frontend>.up.railway.app
ALLOWED_ORIGINS=https://example.up.railway.app

# Cross-origin cookies: when frontend and backend are on different origins
# (the default on Railway), use SameSite=None + Secure=true.
COOKIE_SAMESITE=none
COOKIE_SECURE=true

# Optional (defaults shown).
TOKEN_TTL_MINUTES=480
COOKIE_NAME=activationdesk_session

# ---------- Frontend (Vite) ----------

# Backend URL, read at runtime by the frontend (nginx rewrites /config.js
# at container start). Leave unset for http://localhost:8000 (local dev).
API_BASE=https://<backend>.up.railway.app
