# ============================================================
# Activation Desk — environment variables (reference)
# ============================================================
# Single-service app: the FastAPI backend serves the API and the built
# frontend on the same origin, so there is no CORS or cross-origin cookie
# configuration.
#
# Railway: set these as service variables. The Postgres plugin injects
# DATABASE_URL and PORT automatically. For local dev, copy to a .env next to
# the backend (backend/app reads it from the process env or a local .env).

# Railway injects this automatically when you attach a Postgres.
# The app rewrites postgres:// / postgresql:// to the psycopg3 driver.
DATABASE_URL=postgresql://user:password@host:5432/database

# Session token signing key. REQUIRED in production.
SECRET_KEY=change-me-in-production

# Optional (defaults shown). Secure=true is recommended on HTTPS (Railway).
COOKIE_SECURE=true
TOKEN_TTL_MINUTES=480
COOKIE_NAME=activationdesk_session
