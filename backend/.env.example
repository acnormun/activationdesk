# Copy to .env and adjust for your environment.
SECRET_KEY=change-me-in-production
# PostgreSQL (docker-compose.dev.yml). Comment DATABASE_URL out (or copy
# nothing) to run on the local mock SQLite database instead.
# DATABASE_URL=postgresql+psycopg://activation:activation@localhost:5432/activationdesk
DATABASE_URL=sqlite:///./activationdesk.dev.db
TOKEN_TTL_MINUTES=480
COOKIE_NAME=activationdesk_session
